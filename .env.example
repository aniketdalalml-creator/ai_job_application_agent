# Groq API — used by search fit scoring and Researcher/Writer
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=openai/gpt-oss-120b

# FastAPI
PORT=8000
JWT_SECRET=change-me
JWT_EXPIRE_DAYS=7

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=careerpilot
MYSQL_PASSWORD=
MYSQL_DATABASE=careerpilot
# Optional override:
# DATABASE_URL=mysql+pymysql://careerpilot:password@127.0.0.1:3306/careerpilot

# Job search. auto = Adzuna when keys exist, else Remotive + The Muse (no key).
JOB_PROVIDER=auto
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
SEARCH_LIMIT=20
