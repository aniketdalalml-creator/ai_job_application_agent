# Groq API — used by search fit scoring and Researcher/Writer
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=openai/gpt-oss-120b

# FastAPI
PORT=8000
JWT_SECRET=change-me
JWT_EXPIRE_DAYS=7

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=careerpilot
MYSQL_PASSWORD=
MYSQL_DATABASE=careerpilot
# Optional override:
# DATABASE_URL=mysql+pymysql://careerpilot:password@127.0.0.1:3306/careerpilot

# Job search. auto = Apify (if token) → Adzuna (if keys) → Remotive + The Muse.
JOB_PROVIDER=auto
# APIFY_API_TOKEN is preferred; APIFY_TOKEN is still accepted.
APIFY_API_TOKEN=
APIFY_TOKEN=
# Existing scrapers only. APIFY_JOBS_ACTOR_ID aliases APIFY_ACTOR.
APIFY_JOBS_ACTOR_ID=khadinakbar/jobs-scraper
APIFY_ACTOR=khadinakbar/jobs-scraper
APIFY_LINKEDIN_ACTOR_ID=
APIFY_ACTORS=
APIFY_PLATFORMS=indeed,linkedin
APIFY_TIMEOUT_SECONDS=180
APIFY_REQUEST_TIMEOUT_SECONDS=30
APIFY_POLL_INTERVAL_SECONDS=3
APIFY_RETRY_COUNT=0
APIFY_MAX_ITEMS=50
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
SEARCH_LIMIT=20
